{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schedules.schema.json",
  "title": "Официальное расписание рейсов",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["route_number", "municipality", "transport_type", "stop", "days", "times", "notes", "source_url", "fetched_at"],
    "properties": {
      "route_number": {"type": "string", "minLength": 1},
      "municipality": {"type": "string", "minLength": 1},
      "transport_type": {"type": "string", "enum": ["bus", "tram", "trolleybus"]},
      "stop": {"type": "string", "minLength": 1},
      "days": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "enum": ["будни", "выходные", "ежедневно"]}
      },
      "times": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}
      },
      "notes": {
        "type": "array",
        "items": {"type": "string"}
      },
      "source_url": {"type": "string", "minLength": 1},
      "fetched_at": {"type": "string", "minLength": 1}
    }
  }
}
